{
  "name": "@devscholar/node-with-gjs",
  "version": "0.0.14",
  "description": "Node.js IPC Bridge for GJS",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "types",
    "scripts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
